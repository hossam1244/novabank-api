# Copy to .env for local runs outside docker; the compose stack supplies its own.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite when unset in dev)
# DATABASE_URL=postgres://novabank:novabank@localhost:5432/novabank

# Redis (channel layer, celery broker)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Throttling (overridable without code changes)
# THROTTLE_ANON=30/min
# THROTTLE_USER=120/min
# THROTTLE_PAYMENTS=30/min
